PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SYNC=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173

# Public OAuth client ID from Google Cloud (Web application). No client secret needed.
GOOGLE_CLIENT_ID=

# Stripe Sandbox secret key. Only sk_test_ keys are accepted. Leave blank to disable checkout.
STRIPE_TEST_SECRET_KEY=
