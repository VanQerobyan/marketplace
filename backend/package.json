{
  "name": "marketplace-backend",
  "version": "1.0.0",
  "description": "Backend API for the marketplace graduation project",
  "main": "src/server.js",
  "scripts": {
    "db:migrate:orders": "node scripts/migrate-orders.js",
    "test:payments": "node --test --test-isolation=none test/payments.test.js",
    "db:migrate:google-auth": "node scripts/migrate-google-auth.js",
    "test:google-auth": "node --test --test-isolation=none test/google-auth.test.js",
    "db:migrate:avatar": "node scripts/migrate-avatar.js",
    "db:migrate:listing-images": "node scripts/migrate-listing-images.js",
    "db:migrate:listing-views": "node scripts/migrate-listing-views.js",
    "test:listing-views": "node --test --test-isolation=none test/listing-views.test.js",
    "db:migrate:notification-actor": "node scripts/migrate-notification-actor.js",
    "db:migrate:listing-ratings": "node scripts/migrate-listing-ratings.js",
    "db:migrate:messages": "node scripts/migrate-messages.js",
    "test:messages": "node --test test/messages.test.js",
    "test:message-sockets": "node --test test/message-sockets.test.js",
    "test:notifications": "node --test test/notification-actor.test.js",
    "test:user-search": "node --test test/user-search.test.js",
    "test:listing-images": "node --test test/listing-images.test.js",
